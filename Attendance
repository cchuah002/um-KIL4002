<body>

<h3 id="statusText">Verifying your location...</h3>
<div id="details"></div>

<div id="debugPanel">
  <h4>🛠 Debug Mode</h4>
  <div id="debugContent"></div>
  <br>
  <a id="debugLink" href="#" target="_blank">🔗 Open Form</a>
</div>

<script>

/* =========================
   🔐 DEBUG MODE
========================= */

const urlParams = new URLSearchParams(window.location.search);

const DEBUG =
  (urlParams.get("debug") || "").trim() === "UM_ADMIN_2026";


if (DEBUG) {
  document.getElementById("debugPanel").style.display = "block";
  console.log("DEBUG MODE ACTIVE");
}


/* =========================
   CONFIG
========================= */

const classLat = 3.116635724520063;
const classLon = 101.65595507854434;

const allowedRadius = 200;


/* =========================
   DISTANCE FUNCTION
========================= */

function toRad(x) {
  return x * Math.PI / 180;
}


function calculateDistance(lat1, lon1, lat2, lon2) {

  const R = 6371000;

  const dLat = toRad(lat2 - lat1);
  const dLon = toRad(lon2 - lon1);

  const a =
    Math.sin(dLat / 2) ** 2 +
    Math.cos(toRad(lat1)) *
    Math.cos(toRad(lat2)) *
    Math.sin(dLon / 2) ** 2;

  return 2 * R *
    Math.atan2(
      Math.sqrt(a),
      Math.sqrt(1 - a)
    );
}


/* =========================
   MAIN
========================= */

navigator.geolocation.getCurrentPosition(

  function(position) {

    const lat = position.coords.latitude;
    const lon = position.coords.longitude;
    const acc = position.coords.accuracy;

    const dist =
      calculateDistance(
        classLat,
        classLon,
        lat,
        lon
      );


    /* =========================
       LOCATION STATUS
    ========================= */

    const status =
      (dist <= allowedRadius)
        ? "VALID"
        : "INVALID";


    /* =========================
       SUBMISSION TYPE
    ========================= */

    const submissionType = "Attendance";


    /* =========================
       FORM URL
    ========================= */

    /*
      IMPORTANT:
      Replace the parameter names below with the
      actual pre-filled field parameters generated
      by Microsoft Forms.
    */

    const formURL =
      "https://forms.cloud.microsoft/r/5vjGf91u0e"
      + "?Latitude=" + encodeURIComponent(lat)
      + "&Longitude=" + encodeURIComponent(lon)
      + "&Distance=" + encodeURIComponent(dist.toFixed(2))
      + "&Status=" + encodeURIComponent(status)
      + "&SubmissionType=" + encodeURIComponent(submissionType);


    /* =========================
       DISPLAY DETAILS
    ========================= */

    document.getElementById("details").innerHTML =
      "Distance: " + dist.toFixed(2) + " m<br>" +
      "Status: " + status + "<br>" +
      "Type: " + submissionType;


    /* =========================
       DEBUG MODE
    ========================= */

    if (DEBUG) {

      document.getElementById("statusText").innerHTML =
        "🛠 Debug Mode (No Redirect)";

      document.getElementById("debugContent").innerHTML =
        "Lat: " + lat + "<br>" +
        "Lon: " + lon + "<br>" +
        "Distance: " + dist.toFixed(2) + " m<br>" +
        "Accuracy: ±" + acc.toFixed(2) + " m<br>" +
        "Status: " + status + "<br>" +
        "Type: " + submissionType;

      document.getElementById("debugLink").href =
        formURL;

      console.log("FORM URL:", formURL);

    }


    /* =========================
       NORMAL MODE
    ========================= */

    else {

      if (status === "VALID") {

        document.getElementById("statusText").innerHTML =
          "✅ Location verified. Redirecting...";

        setTimeout(function() {

          window.location.href = formURL;

        }, 1200);

      }

      else {

        document.getElementById("statusText").innerHTML =
          "❌ You are outside the allowed attendance area.";

      }

    }

  },


  /* =========================
     GPS ERROR
  ========================= */

  function(error) {

    console.error(error);

    document.getElementById("statusText").innerHTML =
      "❌ Unable to obtain your location. Please enable GPS/location permission and try again.";

  },


  /* =========================
     GPS OPTIONS
  ========================= */

  {
    enableHighAccuracy: true,
    timeout: 10000,
    maximumAge: 0
  }

);

</script>

</body>
</html>
